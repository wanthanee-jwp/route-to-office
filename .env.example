# Runtime-only settings. Secrets (Google keys + company details) live in
# route-to-office.json when USE_GCP_SECRETS=false, or in Google Cloud Secret
# Manager when USE_GCP_SECRETS=true.

# Toggle between Secret Manager (true) and route-to-office.json (false / unset).
USE_GCP_SECRETS=false

# Google Cloud Secret Manager (only used when USE_GCP_SECRETS=true).
# On Cloud Run, GOOGLE_CLOUD_PROJECT is injected automatically, so
# GCP_PROJECT_ID is only needed for local runs against real GCP.
GCP_PROJECT_ID=pro-creek-445104-d2
GCP_SECRET_NAME=route-to-office-prod
# GCP_SECRET_VERSION=latest

# Optional override for the local secrets file path.
# SECRETS_FILE=route-to-office.json

# Runtime. Cloud Run injects PORT automatically (default 8080); PORT here is
# only used for local dev.
PORT=3000
TZ=Asia/Bangkok

# CORS + Origin-check on /api/config. Comma-separated list of allowed origins.
FRONTEND_ORIGINS=http://localhost:5173

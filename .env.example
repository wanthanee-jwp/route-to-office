# Copy this file to .env and fill in your own low-quota development values.
# In staging / production these values come from AWS Secrets Manager, not from a file.

# Toggle between Secrets Manager (true) and this .env file (false / unset).
USE_AWS_SECRETS=false

# AWS Secrets Manager (only used when USE_AWS_SECRETS=true)
AWS_REGION=ap-southeast-1
AWS_SECRET_NAME=route-to-office/staging

# Google Maps API keys
# Server key: Routes API + Geocoding API only. NEVER exposed to the browser.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Maps JavaScript API only. Served to the frontend via /api/config.
GOOGLE_MAPS_BROWSER_KEY=

# Company / office details (single fixed office in Phase 1)
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_LAT=
COMPANY_LNG=
# Optional. If set, Routes API targets the building entrance instead of a
# rooftop pin. Without it, routing still works using COMPANY_LAT/COMPANY_LNG.
COMPANY_PLACE_ID=

# Runtime
PORT=3000
TZ=Asia/Bangkok

# CORS + Origin-check on /api/config. Comma-separated list of allowed origins.
FRONTEND_ORIGINS=http://localhost:5173

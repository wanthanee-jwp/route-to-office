# Runtime-only settings. Secrets (Google keys + company details) live in
# route-to-office.json when USE_AWS_SECRETS=false, or in AWS Secrets Manager
# when USE_AWS_SECRETS=true.

# Toggle between Secrets Manager (true) and route-to-office.json (false / unset).
USE_AWS_SECRETS=false

# AWS Secrets Manager (only used when USE_AWS_SECRETS=true)
AWS_REGION=ap-southeast-1
AWS_SECRET_NAME=route-to-office/staging

# Optional override for the local secrets file path.
# SECRETS_FILE=route-to-office.json

# Runtime
PORT=3000
TZ=Asia/Bangkok

# CORS + Origin-check on /api/config. Comma-separated list of allowed origins.
FRONTEND_ORIGINS=http://localhost:5173
